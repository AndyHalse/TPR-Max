{
  "name": "visigate-print-service",
  "version": "1.0.0",
  "description": "VisiGate Print Service - Windows thermal printer polling service",
  "main": "VisiGatePrintService.js",
  "scripts": {
    "start": "node VisiGatePrintService.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/VisiGatePrintService.exe",
    "build:msi": "npm run build:exe && node build-msi.js",
    "install-service": "node install-service.js",
    "uninstall-service": "node uninstall-service.js"
  },
  "pkg": {
    "scripts": "VisiGatePrintService.js",
    "assets": [
      "config.json.example"
    ],
    "outputPath": "dist",
    "targets": ["node18-win-x64"]
  },
  "dependencies": {
    "node-windows": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "author": "VisiGate Pro",
  "license": "MIT"
}