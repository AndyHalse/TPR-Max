# ---------------------------------------------------------------------------
# TPR Max — required environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tprmax

# Secret used to sign Express sessions. Use a long random string (32+ chars).
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Secret used to sign short-lived HMAC logo tokens.
# Must be set to a random string of at least 32 characters.
# Do NOT reuse SESSION_SECRET or DATABASE_URL here.
LOGO_TOKEN_SECRET=replace-with-a-different-random-string-of-at-least-32-chars

# Stripe secret key (from Stripe dashboard → Developers → API keys)
STRIPE_SECRET_KEY=sk_live_...

# 8x8 API key for voice/lone-worker welfare check notifications
EIGHT_X_EIGHT_API_KEY=

# SendGrid API key for transactional email
SENDGRID_API_KEY=

# Replit AI integration key (if using Replit-hosted AI features)
REPLIT_AI_API_KEY=

# Anthropic Claude API key — powers the in-app Help Assistant and other AI
# features as a platform-wide fallback when a customer hasn't saved their own
# key in Settings → AI. Get one from https://console.anthropic.com/
ANTHROPIC_API_KEY=
